APP_NAME=SignalForge
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/content_generator
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
CSRF_SECRET=change-me-again
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_URL=http://localhost:5173
SEND_AUTH_EMAIL_ON_SIGNUP=false
COOKIE_SECURE=false
ENCRYPTION_KEY=
EXTERNAL_SECRET_REFERENCES_JSON={}
STORAGE_BUCKET=content-generator
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/content-generator
# s3 = MinIO/S3; local = filesystem under STORAGE_LOCAL_ROOT (served at /api/v1/media)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
LLM_PROVIDER=mock
LLM_MODEL=mock-gpt
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_JSON_ENFORCEMENT=best_effort
LLM_TASK_MODELS_JSON={}
LLM_BASE_URL=
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1
EMBEDDINGS_PROVIDER=hashing
EMBEDDINGS_MODEL=nomic-embed-text
INGESTION_DISABLE_AFTER_FAILURES=5
ENABLE_X_SIGNAL_CONNECTOR=false
ENABLE_BLUESKY_SIGNAL_CONNECTOR=false
ENABLE_GOOGLE_TRENDS_CONNECTOR=false
ENABLE_OFFICIAL_SOURCE_CONNECTOR=true
GOOGLE_TRENDS_REGION=US
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CALLBACK_SIGNING_SECRET=
WHATSAPP_PROVIDER=stub
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_DEFAULT_RECIPIENT=+10000000000
SOCIAL_DRY_RUN_BY_DEFAULT=true
PUBLIC_URL=http://localhost:8000
DEMO_SEED_ENABLED=true
DEMO_ADMIN_EMAIL=demo@example.com
DEMO_ADMIN_PASSWORD=password1234
DEMO_ADMIN_NAME=Demo Operator
# --- Chess intelligence (Phase 30) ---
# Provider secrets stay server-side only. Never put these in frontend Vite env.
# Per-provider timeouts (there is no CHESS_PROVIDER_TIMEOUT_SECONDS).

# Lichess (masters explorer + puzzles). Optional Bearer token; never expose to clients.
LICHESS_API_TOKEN=
LICHESS_API_BASE_URL=https://lichess.org
LICHESS_EXPLORER_BASE_URL=https://explorer.lichess.org
LICHESS_HTTP_TIMEOUT_SECONDS=20
LICHESS_HTTP_MAX_RETRIES=2
LICHESS_RATE_LIMIT_RPH=60

# Chess.com PubAPI (no auth). Identify via User-Agent; fair-use rate limit.
CHESSCOM_API_BASE_URL=https://api.chess.com
CHESSCOM_USER_AGENT=SignalForgeChessIntelligence/1.0 (contact: ops@localhost)
CHESSCOM_HTTP_TIMEOUT_SECONDS=20
CHESSCOM_HTTP_MAX_RETRIES=2
CHESSCOM_RATE_LIMIT_RPH=60

# Shared outbound HTTP concurrency budgets (core.http provider keys: lichess / chesscom)
HTTP_PROVIDER_LICHESS_CONCURRENCY=2
HTTP_PROVIDER_CHESSCOM_CONCURRENCY=2

# Provider response cache (Redis TenantCache)
CHESS_CACHE_MASTERS_SEARCH_TTL_SECONDS=1800
CHESS_CACHE_GAME_PGN_TTL_SECONDS=604800
CHESS_CACHE_PUZZLE_TTL_SECONDS=604800
CHESS_CACHE_PROVIDER_META_TTL_SECONDS=3600
CHESS_CACHE_DAILY_PUZZLE_TTL_SECONDS=21600

# Stockfish external binary (not a PyPI package). Empty → analysis returns 503.
STOCKFISH_PATH=
CHESS_ENGINE_DEPTH=12
CHESS_ENGINE_TIME_LIMIT=
CHESS_ENGINE_HASH_MB=64
CHESS_ENGINE_THREADS=1
OTLP_ENDPOINT=
OTLP_INSECURE=true
