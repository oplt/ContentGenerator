redis: sh -c 'redis-cli -h 127.0.0.1 -p 6379 ping >/dev/null 2>&1 && echo "Redis already running" && tail -f /dev/null || redis-server'
# Migrate once here; workers/beat rely on make migrate + this gate (no per-process Alembic).
backend: sh -c 'export PYTHONPATH="$PWD" && backend/.venv/bin/alembic -c backend/alembic.ini upgrade head && backend/.venv/bin/uvicorn backend.api.main:app --reload --reload-dir backend --host 127.0.0.1 --port 8000'
# Specialized workers mirror docker-compose (Phase 14 / bugs.txt) so video/LLM cannot starve ops queues.
worker_io: sh -c 'export PYTHONPATH="$PWD" && until curl -fsS http://127.0.0.1:8000/api/v1/health/live >/dev/null 2>&1; do sleep 0.3; done; backend/.venv/bin/celery -A backend.workers.celery_app:celery_app worker --loglevel=INFO --pool=gevent --concurrency=4 --prefetch-multiplier=1 --hostname=worker-io@%h --queues=ingestion,email,approvals'
worker_llm: sh -c 'export PYTHONPATH="$PWD" && until curl -fsS http://127.0.0.1:8000/api/v1/health/live >/dev/null 2>&1; do sleep 0.3; done; backend/.venv/bin/celery -A backend.workers.celery_app:celery_app worker --loglevel=INFO --pool=gevent --concurrency=2 --prefetch-multiplier=1 --hostname=worker-llm@%h --queues=generation,enrichment'
worker_media: sh -c 'export PYTHONPATH="$PWD" && until curl -fsS http://127.0.0.1:8000/api/v1/health/live >/dev/null 2>&1; do sleep 0.3; done; backend/.venv/bin/celery -A backend.workers.celery_app:celery_app worker --loglevel=INFO --pool=prefork --concurrency=1 --prefetch-multiplier=1 --hostname=worker-media@%h --queues=video'
worker_publishing: sh -c 'export PYTHONPATH="$PWD" && until curl -fsS http://127.0.0.1:8000/api/v1/health/live >/dev/null 2>&1; do sleep 0.3; done; backend/.venv/bin/celery -A backend.workers.celery_app:celery_app worker --loglevel=INFO --pool=gevent --concurrency=2 --prefetch-multiplier=1 --hostname=worker-publishing@%h --queues=publishing'
worker_db: sh -c 'export PYTHONPATH="$PWD" && until curl -fsS http://127.0.0.1:8000/api/v1/health/live >/dev/null 2>&1; do sleep 0.3; done; backend/.venv/bin/celery -A backend.workers.celery_app:celery_app worker --loglevel=INFO --pool=gevent --concurrency=2 --prefetch-multiplier=1 --hostname=worker-db@%h --queues=analytics'
beat: sh -c 'export PYTHONPATH="$PWD" && until curl -fsS http://127.0.0.1:8000/api/v1/health/live >/dev/null 2>&1; do sleep 0.3; done; backend/.venv/bin/celery -A backend.workers.celery_app:celery_app beat --loglevel=INFO --scheduler celery.beat.PersistentScheduler --schedule=/tmp/celerybeat-schedule'
# Wait for API liveness before Vite so bootstrap calls do not ECONNREFUSED.
frontend: sh -c 'until curl -fsS http://127.0.0.1:8000/api/v1/health/live >/dev/null 2>&1; do sleep 0.3; done; cd frontend && npm run dev'
browser: sh -c 'until curl -fsS http://127.0.0.1:8000/api/v1/health/ready >/dev/null 2>&1; do sleep 0.2; done; until curl -fsS http://127.0.0.1:5173 >/dev/null 2>&1; do sleep 0.2; done; xdg-open http://127.0.0.1:5173 >/dev/null 2>&1 || true; tail -f /dev/null'
# Opt-in only: LLAMA_CPP_ENABLE=1. Failures must not tear down honcho (app uses LLM_PROVIDER=ollama).
# Ollama local note: CPU-only / OLLAMA_NUM_PARALLEL=1 is a throughput bottleneck; keep generation concurrency low.
llama_cpp: sh -c 'if [ "${LLAMA_CPP_ENABLE:-0}" != "1" ]; then echo "llama.cpp skipped (set LLAMA_CPP_ENABLE=1 to enable)"; exec tail -f /dev/null; fi; BIN="/home/polat/Desktop/Projects/llama.cpp/build/bin/llama-server"; MODEL="/home/polat/Desktop/Projects/llama.cpp/models/Qwen_Qwen3-14B-Q4_K_M.gguf"; if curl -s http://127.0.0.1:8081/v1/models >/dev/null 2>&1; then echo "llama.cpp already running, skipping..."; exec tail -f /dev/null; fi; if [ ! -x "$BIN" ] || [ ! -f "$MODEL" ]; then echo "llama.cpp skipped: binary or GGUF missing ($MODEL)"; exec tail -f /dev/null; fi; "$BIN" -m "$MODEL" --host 127.0.0.1 --port 8081 -c 4096 -ngl 0 -fa on -b 512 -ub 256 -t 8 || echo "llama.cpp exited rc=$?; keeping stub alive"; exec tail -f /dev/null'
ollama: sh -c 'if curl -s http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then echo "Ollama already running, skipping..."; exec tail -f /dev/null; fi; if ! command -v ollama >/dev/null 2>&1; then echo "ollama binary missing; stack continues"; exec tail -f /dev/null; fi; ollama serve || echo "ollama exited rc=$?; keeping stub alive"; exec tail -f /dev/null'
